# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos (PostgreSQL / Supabase) ---------------------------------
# Conexión de la APLICACIÓN: rol `sas_app` (sin BYPASSRLS). En Supabase usa el
# pooler en modo transacción (puerto 6543), usuario `sas_app.<project-ref>`.
DATABASE_URL=postgresql://sas_app:cambia-esta-clave@localhost:5432/sas

# Conexión PRIVILEGIADA solo para SuperAdmin/tareas de plataforma (cliente
# separado y auditado). Rol dueño de las tablas (p. ej. `postgres`).
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sas

# Conexión directa para migraciones (Prisma CLI). Mismo rol dueño; en Supabase
# usa la conexión directa (puerto 5432), no el pooler.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/sas

# Solo para `npm run superadmin:create` (se leen del entorno, no se guardan):
#   SUPERADMIN_EMAIL=... SUPERADMIN_PASSWORD=... npm run superadmin:create

# Contraseña que `npm run db:app-role` asigna al rol `sas_app` (debe coincidir
# con la de DATABASE_URL). Solo se usa en ese script.
APP_DB_PASSWORD=cambia-esta-clave

# --- Cifrado de credenciales de terceros ------------------------------------
# 32 bytes en base64 (AES-256-GCM). Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Sesión y URL pública ---------------------------------------------------
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET=
# URL pública de la app (se usa en los enlaces de los correos).
APP_URL=http://localhost:3000

# --- Correo de plataforma (invitaciones y recuperación de contraseña) -------
# Obligatorio en producción. Ej.: smtps://usuario:clave@smtp.tu-proveedor.com:465
SMTP_URL=
SMTP_FROM="Mecania <no-reply@tu-dominio.com>"

# --- Captcha del botón "Acceso Demo" (Cloudflare Turnstile) -----------------
# Obligatorio en producción. Sin ellas, en desarrollo el captcha se omite.
# Crea un widget (modo "Managed") en https://dash.cloudflare.com → Turnstile con tu dominio de Vercel.
# NO uses las claves de prueba de Cloudflare (1x00000000000000000000AA / 1x0000000000000000000000000000000AA):
# muestran el aviso "Solo para pruebas" y aprueban cualquier cosa. NEXT_PUBLIC_TURNSTILE_SITE_KEY se incrusta
# al compilar: tras cambiarla en Vercel hay que volver a desplegar.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- WhatsApp comercial (opcional) -------------------------------------------
# Número del equipo de ventas con código de país (solo dígitos o con "+", espacios y guiones).
# El botón "Activar plan" de las cuentas demo abre WhatsApp con el mensaje
# "Hola, quiero activar el plan para mi taller (cuenta demo: <nombre del taller>)".
# Sin esta variable, el botón lleva a /app/subscription.
NEXT_PUBLIC_SALES_WHATSAPP=

# --- Fotos y firmas del taller (Supabase Storage, buckets privados) -------------
# Obligatorias en producción. STORAGE_DRIVER=local guarda en disco (solo desarrollo/CI; en Vercel es efímero).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_DRIVER=local

# --- Jobs (Inngest): limpieza de demos vencidas ------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Solo para pruebas de integración (npm run test:integration) ------------
# Usuario dueño con permiso CREATE DATABASE. Cada ejecución crea y destruye su
# propia base `sas_test_<id>`.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Cobro de la suscripción del SaaS (Fase 7) ---
# none = sin cobro automático (el SuperAdmin registra pagos manuales). Opciones: stripe | mercadopago | simulated (solo desarrollo/CI).
BILLING_GATEWAY=none
# Stripe: clave secreta (sk_...) y secreto del endpoint de webhook (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago: access token de la aplicación y clave secreta de las notificaciones.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Solo con BILLING_GATEWAY=simulated (mínimo 16 caracteres).
BILLING_SIMULATED_SECRET=
# Días de acceso tras vencer el periodo sin pago, antes de suspender (0 a 30).
BILLING_GRACE_DAYS=7
# Días de espera entre cobros automáticos fallidos.
BILLING_RETRY_DAYS=1,3,5

# 2FA obligatorio para el SuperAdmin (true por defecto). "false" permite entrar solo con correo y contraseña:
# úsalo únicamente de forma temporal (en producción cada ingreso sin 2FA queda en el log como advertencia).
SUPERADMIN_REQUIRE_2FA=true
