  // Guardrails excedidos => requiere confirmación humana.
  requiresHuman       Boolean       @default(true)
  guardrailViolations Json?
  purchaseOrderId     String?       @db.Uuid
  idempotencyKey      String
  decidedById         String?       @db.Uuid
  decidedAt           DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  aiRun         AiRun          @relation(fields: [tenantId, aiRunId], references: [tenantId, id], onDelete: Restrict)
  supplier      Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)

  items AiOrderDraftItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("ai_order_drafts")
}

model AiOrderDraftItem {
  id        String  @id @default(uuid(7)) @db.Uuid
