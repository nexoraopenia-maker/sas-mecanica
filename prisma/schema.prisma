}

model AiOrderDraft {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @default(dbgenerated("app_current_tenant()")) @db.Uuid
  aiRunId             String        @db.Uuid
  supplierId          String        @db.Uuid
  status              AiDraftStatus @default(PENDING)
  messageDraft        String
  total               Decimal       @default(0) @db.Decimal(14, 2)
