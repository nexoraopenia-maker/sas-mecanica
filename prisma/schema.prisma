model CashSession {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @default(dbgenerated("app_current_tenant()")) @db.Uuid
  branchId         String            @db.Uuid
  openedById       String            @db.Uuid
  closedById       String?           @db.Uuid
  status           CashSessionStatus @default(OPEN)
  openingAmount    Decimal           @db.Decimal(14, 2)
  expectedAmount   Decimal?          @db.Decimal(14, 2)
  countedAmount    Decimal?          @db.Decimal(14, 2)
  difference       Decimal?          @db.Decimal(14, 2)
  // Arqueo por medio de pago.
  closingBreakdown Json?
  notes            String?
  // Solo mientras está abierta (`{usuario}:{sucursal}`): el índice único impide dos cajas abiertas.
  openKey          String?
  openedAt         DateTime          @default(now()) @db.Timestamptz(3)
  closedAt         DateTime?         @db.Timestamptz(3)

  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  openedBy User   @relation(fields: [tenantId, openedById], references: [tenantId, id], onDelete: Restrict)

  movements CashMovement[]
  sales     Sale[]
  payments  SalePayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, openKey])
  @@index([tenantId, branchId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @default(dbgenerated("app_current_tenant()")) @db.Uuid
  sessionId   String           @db.Uuid
  type        CashMovementType
  amount      Decimal          @db.Decimal(14, 2)
  reason      String
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  session CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, sessionId])
  @@map("cash_movements")
}

model Sale {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number         Int
  branchId       String            @db.Uuid
  warehouseId    String            @db.Uuid
  cashSessionId  String?           @db.Uuid
  customerId     String?           @db.Uuid
  vehicleId      String?           @db.Uuid
  workOrderId    String?           @db.Uuid
  quoteId        String?           @db.Uuid
  sellerId       String?           @db.Uuid
  status         SaleStatus        @default(DRAFT)
  paymentStatus  SalePaymentStatus @default(UNPAID)
  isCredit       Boolean           @default(false)
  currency       String            @default("PEN")
  subtotal       Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal           @default(0) @db.Decimal(14, 2)
  total          Decimal           @default(0) @db.Decimal(14, 2)
  paidTotal      Decimal           @default(0) @db.Decimal(14, 2)
  idempotencyKey String
  documentType   DocumentType      @default(NOTA_VENTA)
  notes          String?
  voidedAt       DateTime?         @db.Timestamptz(3)
  voidedById     String?           @db.Uuid
  voidReason     String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  branch      Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  warehouse   Warehouse    @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession? @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicle     Vehicle?     @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  workOrder   WorkOrder?   @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict)
  quote       Quote?       @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  seller      User?        @relation(fields: [tenantId, sellerId], references: [tenantId, id], onDelete: Restrict)

  items      SaleItem[]
  payments   SalePayment[]
  receivable Receivable?
  returns    SaleReturn[]
  documents  FiscalDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("sales")
}

model SaleItem {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  saleId           String         @db.Uuid
  productId        String?        @db.Uuid
  lotId            String?        @db.Uuid
  serialId         String?        @db.Uuid
  description      String
  quantity         Decimal        @db.Decimal(14, 4)
  unitPrice        Decimal        @db.Decimal(14, 4)
  // Costo promedio al momento de la venta (margen).
  unitCost         Decimal        @default(0) @db.Decimal(14, 4)
  discount         Decimal        @default(0) @db.Decimal(14, 2)
  taxAffectation   TaxAffectation @default(TAXED)
  taxRate          Decimal        @default(0) @db.Decimal(7, 4)
  lineTotal        Decimal        @db.Decimal(14, 2)
  kardexMovementId String?        @db.Uuid

  sale    Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  product Product?      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot     StockLot?     @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  serial  SerialNumber? @relation(fields: [tenantId, serialId], references: [tenantId, id], onDelete: Restrict)

  returnItems SaleReturnItem[]
  warranties  Warranty[]

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model SalePayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @default(dbgenerated("app_current_tenant()")) @db.Uuid
  saleId         String        @db.Uuid
  cashSessionId  String?       @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  reference      String?
  receivedById   String?       @db.Uuid
  // Cobros de cuentas por cobrar: evita registrar dos veces el mismo pago.
  idempotencyKey String?
  paidAt         DateTime      @default(now()) @db.Timestamptz(3)

  sale        Sale         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession? @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId])
  @@index([tenantId, cashSessionId])
  @@map("sale_payments")
}

model Receivable {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @default(dbgenerated("app_current_tenant()")) @db.Uuid
  saleId     String           @db.Uuid
  customerId String           @db.Uuid
  total      Decimal          @db.Decimal(14, 2)
  balance    Decimal          @db.Decimal(14, 2)
  dueDate    DateTime         @db.Timestamptz(3)
  status     ReceivableStatus @default(OPEN)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  sale     Sale     @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, saleId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@map("receivables")
}

model SaleReturn {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number         Int
  saleId         String           @db.Uuid
  resolution     ReturnResolution
  reason         String
  total          Decimal          @db.Decimal(14, 2)
  idempotencyKey String
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  items     SaleReturnItem[]
  documents FiscalDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @default(dbgenerated("app_current_tenant()")) @db.Uuid
  returnId         String  @db.Uuid
  saleItemId       String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 4)
  // Importe devuelto de esta línea (con IGV): la suma de devoluciones nunca excede lo vendido.
  amount           Decimal @default(0) @db.Decimal(14, 2)
  restock          Boolean @default(true)
  kardexMovementId String? @db.Uuid

  saleReturn SaleReturn @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@map("sale_return_items")
}

// Comprobante electrónico (boleta/factura/NC/ND) emitido vía OSE/PSE.
model FiscalDocument {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @default(dbgenerated("app_current_tenant()")) @db.Uuid
  saleId            String?      @db.Uuid
  saleReturnId      String?      @db.Uuid
  relatedDocumentId String?      @db.Uuid
  // Una venta emite un solo comprobante principal; cada devolución, una nota (idempotencia).
  docKey            String
  type              DocumentType
  series            String
  correlative       Int
  issueDate         DateTime     @db.Timestamptz(3)
  currency          String
  customerSnapshot  Json
  itemsSnapshot     Json
  noteReasonCode    String?
  noteReason        String?
  subtotal          Decimal      @db.Decimal(14, 2)
  taxTotal          Decimal      @db.Decimal(14, 2)
  total             Decimal      @db.Decimal(14, 2)
  status            FiscalStatus @default(PENDING)
  providerRef       String?
  hash              String?
  xmlUrl            String?
  pdfUrl            String?
  cdrUrl            String?
  errorMessage      String?
  attempts          Int          @default(0)
  nextRetryAt       DateTime?    @db.Timestamptz(3)
  sentAt            DateTime?    @db.Timestamptz(3)
  lastSharedAt      DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  sale       Sale?           @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  saleReturn SaleReturn?     @relation(fields: [tenantId, saleReturnId], references: [tenantId, id], onDelete: Restrict)
  related    FiscalDocument? @relation("DocumentRelation", fields: [tenantId, relatedDocumentId], references: [tenantId, id], onDelete: Restrict)

  relatedBy FiscalDocument[] @relation("DocumentRelation")

  @@unique([tenantId, id])
  @@unique([tenantId, type, series, correlative])
  @@unique([tenantId, docKey])
  @@index([tenantId, status, nextRetryAt])
  @@map("fiscal_documents")
}

// -----------------------------------------------------------------------------
// GARANTÍAS
// -----------------------------------------------------------------------------

model Warranty {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  source           WarrantySource
  customerId       String?        @db.Uuid
  vehicleId        String?        @db.Uuid
  productId        String?        @db.Uuid
  policyId         String?        @db.Uuid
  saleItemId       String?        @db.Uuid
  workOrderItemId  String?        @db.Uuid
  serialId         String?        @db.Uuid
  lotId            String?        @db.Uuid
  description      String
  status           WarrantyStatus @default(ACTIVE)
  coversLabor      Boolean        @default(false)
  startsAt         DateTime       @db.Timestamptz(3)
  expiresAt        DateTime?      @db.Timestamptz(3)
  expiresAtMileage Int?
  startMileage     Int?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  customer      Customer?       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicle       Vehicle?        @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  product       Product?        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  policy        WarrantyPolicy? @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)
  saleItem      SaleItem?       @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)
  workOrderItem WorkOrderItem?  @relation(fields: [tenantId, workOrderItemId], references: [tenantId, id], onDelete: Restrict)
  serial        SerialNumber?   @relation(fields: [tenantId, serialId], references: [tenantId, id], onDelete: Restrict)
  lot           StockLot?       @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)

  claims WarrantyClaim[]

  @@unique([tenantId, id])
  @@unique([tenantId, workOrderItemId])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, serialId])
  @@map("warranties")
}

model WarrantyClaim {
  id                     String          @id @default(uuid(7)) @db.Uuid
  tenantId               String          @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number                 Int
  warrantyId             String          @db.Uuid
  status                 ClaimStatus     @default(RECEIVED)
  resolution             ClaimResolution @default(NONE)
  description            String
  evaluation             String?
  mileageAtClaim         Int?
  // Reconocimiento humano cuando la garantía ya venció o superó el kilometraje.
  coverageOverrideReason String?
  // Nota de crédito pendiente de emitir (Fase 6) o movimiento de la unidad de reposición.
  creditAmount           Decimal?        @db.Decimal(14, 2)
  replacementMovementId  String?         @db.Uuid
  replacementWarrantyId  String?         @db.Uuid
  receivedById           String?         @db.Uuid
  evaluatedById          String?         @db.Uuid
  resolvedAt             DateTime?       @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  warranty Warranty @relation(fields: [tenantId, warrantyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("warranty_claims")
}

// -----------------------------------------------------------------------------
// TRANSVERSALES
// -----------------------------------------------------------------------------

// Numeración correlativa segura ante concurrencia (ver lib/db/sequence.ts).
model DocumentSequence {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @default(dbgenerated("app_current_tenant()")) @db.Uuid
  docType  String
  series   String @default("")
  current  Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, docType, series])
  @@map("document_sequences")
}

// Notificación in-app para el personal (alertas de stock, garantías...).
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  userId    String?   @db.Uuid
  kind      String
  severity  Severity  @default(INFO)
  title     String
  body      String?
  data      Json?
  dedupeKey String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// Cola de salida a clientes/proveedores (WhatsApp, correo). En demo los
// envíos quedan en estado SIMULATED y nunca salen mensajes reales.
model OutboundMessage {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  channel        MessageChannel
  toAddress      String
  subject        String?
  body           String
  status         OutboundStatus @default(PENDING)
  attempts       Int            @default(0)
  providerRef    String?
  error          String?
  relatedType    String?
  relatedId      String?        @db.Uuid
  idempotencyKey String
  scheduledAt    DateTime       @default(now()) @db.Timestamptz(3)
  sentAt         DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, scheduledAt])
  @@map("outbound_messages")
}

// INMUTABLE: solo INSERT. tenantId null = acción de plataforma.
model AuditLog {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String?   @db.Uuid
  actorType          ActorType
  actorUserId        String?   @db.Uuid
  impersonatorUserId String?   @db.Uuid
  action             String
  entityType         String
  entityId           String?
  before             Json?
  after              Json?
  reason             String?
  ip                 String?
  userAgent          String?
  requestId          String?
  occurredAt         DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
  @@map("audit_logs")
}

// Contadores de rate limiting (login, demo, webhooks). Tabla de plataforma, sin
// datos sensibles: la clave es un hash. Ver lib/db/rate-limit.ts.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
