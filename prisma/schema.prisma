// -----------------------------------------------------------------------------

model WorkOrder {
  id                     String          @id @default(uuid(7)) @db.Uuid
  tenantId               String          @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number                 Int
  branchId               String          @db.Uuid
  customerId             String          @db.Uuid
  vehicleId              String          @db.Uuid
  assignedMechanicId     String?         @db.Uuid
  quoteId                String?         @db.Uuid
  status                 WorkOrderStatus @default(RECEIVED)
  mileageIn              Int?
  mileageOut             Int?
  fuelLevelEighths       Int?
  complaint              String?
  diagnosis              String?
  internalNotes          String?
  receivedAt             DateTime        @default(now()) @db.Timestamptz(3)
  promisedAt             DateTime?       @db.Timestamptz(3)
  deliveredAt            DateTime?       @db.Timestamptz(3)
  // Aprobación del presupuesto por el cliente (enlace o firma).
  approvalTokenHash      String?
  // El enlace de aprobación vence y es de un solo uso (ver server/services/work-order-approval.ts).
  approvalTokenExpiresAt DateTime?       @db.Timestamptz(3)
  // Ronda vigente: los trabajos adicionales abren una ronda nueva que el cliente debe aprobar.
  currentApprovalRound   Int             @default(1)
  approvedAt             DateTime?       @db.Timestamptz(3)
  approvalMethod         String?
  approvedByName         String?
  approvalIp             String?
  signatureUrl           String?
  subtotal               Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @db.Decimal(14, 2)
  total                  Decimal         @default(0) @db.Decimal(14, 2)
  createdById            String?         @db.Uuid
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?       @db.Timestamptz(3)

  branch           Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer         Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicle          Vehicle  @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  assignedMechanic User?    @relation("WorkOrderMechanic", fields: [tenantId, assignedMechanicId], references: [tenantId, id], onDelete: Restrict)
  quote            Quote?   @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)

  items         WorkOrderItem[]
  checklist     WorkOrderChecklistItem[]
  photos        WorkOrderPhoto[]
  statusHistory WorkOrderStatusHistory[]
  sales         Sale[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([approvalTokenHash], map: "work_orders_approvalToken_key")
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, assignedMechanicId, status])
  @@map("work_orders")
}

model WorkOrderItem {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenantId              String            @default(dbgenerated("app_current_tenant()")) @db.Uuid
  workOrderId           String            @db.Uuid
  type                  WorkOrderItemType
  productId             String?           @db.Uuid
  mechanicId            String?           @db.Uuid
  description           String
  quantity              Decimal           @default(1) @db.Decimal(14, 4)
  unitPrice             Decimal           @db.Decimal(14, 4)
  unitCost              Decimal           @default(0) @db.Decimal(14, 4)
  discount              Decimal           @default(0) @db.Decimal(14, 2)
  taxAffectation        TaxAffectation    @default(TAXED)
  // Trabajos adicionales requieren una nueva ronda de aprobación.
  approvalRound         Int               @default(1)
  approvalStatus        ApprovalStatus    @default(PENDING)
  partStatus            PartRequestStatus @default(NOT_APPLICABLE)
  consumptionMovementId String?           @db.Uuid
  // Garantía de la mano de obra (si el trabajo la tiene); los repuestos usan la política del producto.
  warrantyPolicyId      String?           @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  workOrder      WorkOrder       @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  product        Product?        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  mechanic       User?           @relation(fields: [tenantId, mechanicId], references: [tenantId, id], onDelete: Restrict)
  warrantyPolicy WarrantyPolicy? @relation(fields: [tenantId, warrantyPolicyId], references: [tenantId, id], onDelete: Restrict)

  warranties Warranty[]

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId])
  @@index([tenantId, partStatus])
  @@map("work_order_items")
}

model WorkOrderChecklistItem {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @default(dbgenerated("app_current_tenant()")) @db.Uuid
  workOrderId String            @db.Uuid
  category    ChecklistCategory
  label       String
  checked     Boolean           @default(false)
  value       String?
  notes       String?

  workOrder WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)

