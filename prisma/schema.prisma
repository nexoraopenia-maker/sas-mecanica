// -----------------------------------------------------------------------------
// INVENTARIO: lotes, series, kardex, saldos
// -----------------------------------------------------------------------------

model StockLot {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  productId      String    @db.Uuid
  code           String
  // Llantas: código DOT (semana+año de fabricación), p. ej. "2423".
  dotCode        String?
  manufacturedAt DateTime? @db.Date
  receivedAt     DateTime  @default(now()) @db.Timestamptz(3)
  unitCost       Decimal?  @db.Decimal(14, 4)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  serials       SerialNumber[]
  balances      StockLotBalance[]
  kardex        KardexMovement[]
  transferItems StockTransferItem[]
  countItems    InventoryCountItem[]
  receiptItems  PurchaseReceiptItem[]
  saleItems     SaleItem[]
  warranties    Warranty[]

  @@unique([tenantId, id])
  @@unique([tenantId, productId, code])
  @@index([tenantId, manufacturedAt])
  @@map("stock_lots")
}

model SerialNumber {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @default(dbgenerated("app_current_tenant()")) @db.Uuid
  productId   String       @db.Uuid
  lotId       String?      @db.Uuid
  warehouseId String?      @db.Uuid
  serial      String
  status      SerialStatus @default(IN_STOCK)
  soldAt      DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  product   Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       StockLot?  @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse? @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  kardex        KardexMovement[]
  transferItems StockTransferItem[]
  receiptItems  PurchaseReceiptItem[]
  saleItems     SaleItem[]
  warranties    Warranty[]

  @@unique([tenantId, id])
  @@unique([tenantId, productId, serial])
  @@index([tenantId, status])
  @@index([tenantId, serial])
  @@map("serial_numbers")
}

// Saldo por producto/almacén. SOLO lo escribe el trigger del kardex.
model StockBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  // Costo promedio ponderado.
  avgCost     Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @default(now()) @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("stock_balances")
}

model StockLotBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  lotId       String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @default(now()) @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       StockLot  @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, lotId])
  @@index([tenantId, productId])
  @@map("stock_lot_balances")
}

// Mínimo / punto de reorden: calculado por rotación o fijado manualmente.
model ReorderPolicy {
  id                   String      @id @default(uuid(7)) @db.Uuid
  tenantId             String      @default(dbgenerated("app_current_tenant()")) @db.Uuid
  warehouseId          String      @db.Uuid
  productId            String      @db.Uuid
  mode                 ReorderMode @default(AUTO)
  manualMinStock       Decimal?    @db.Decimal(14, 4)
  manualReorderPoint   Decimal?    @db.Decimal(14, 4)
  computedMinStock     Decimal?    @db.Decimal(14, 4)
  computedReorderPoint Decimal?    @db.Decimal(14, 4)
  avgDailySales30      Decimal?    @db.Decimal(14, 4)
  avgDailySales90      Decimal?    @db.Decimal(14, 4)
  seasonalityFactor    Decimal     @default(1) @db.Decimal(6, 3)
  computedAt           DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@map("reorder_policies")
}

// INMUTABLE: solo INSERT. El trigger actualiza saldos y costo promedio.
model KardexMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @default(dbgenerated("app_current_tenant()")) @db.Uuid
  warehouseId    String       @db.Uuid
  productId      String       @db.Uuid
  lotId          String?      @db.Uuid
  serialId       String?      @db.Uuid
  type           MovementType
  // Con signo: entradas > 0, salidas < 0 (CHECK por tipo en BD).
  quantityDelta  Decimal      @db.Decimal(14, 4)
  // Costo unitario de la entrada (obligatorio en entradas valorizadas).
  unitCost       Decimal?     @db.Decimal(14, 4)
  // Calculados por el trigger.
  balanceAfter   Decimal      @default(0) @db.Decimal(14, 4)
  avgCostAfter   Decimal      @default(0) @db.Decimal(14, 4)
  reason         String?
  referenceType  String?
  referenceId    String?      @db.Uuid
  // Permite dejar saldo negativo; el servicio exige `permitir_stock_negativo`.
  allowNegative  Boolean      @default(false)
  idempotencyKey String
  createdById    String?      @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)

  warehouse Warehouse     @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       StockLot?     @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  serial    SerialNumber? @relation(fields: [tenantId, serialId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, warehouseId, occurredAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, occurredAt])
  @@map("kardex_movements")
}

model StockTransfer {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number          Int
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  status          TransferStatus @default(REQUESTED)
  notes           String?
  requestedById   String?        @db.Uuid
  shippedAt       DateTime?      @db.Timestamptz(3)
  receivedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  fromWarehouse Warehouse @relation("TransferFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id], onDelete: Restrict)
  toWarehouse   Warehouse @relation("TransferTo", fields: [tenantId, toWarehouseId], references: [tenantId, id], onDelete: Restrict)

  items StockTransferItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @default(dbgenerated("app_current_tenant()")) @db.Uuid
  transferId   String  @db.Uuid
  productId    String  @db.Uuid
  lotId        String? @db.Uuid
  serialId     String? @db.Uuid
  qtyRequested Decimal @db.Decimal(14, 4)
  qtyShipped   Decimal @default(0) @db.Decimal(14, 4)
  qtyReceived  Decimal @default(0) @db.Decimal(14, 4)

  transfer StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot      StockLot?     @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  serial   SerialNumber? @relation(fields: [tenantId, serialId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, transferId])
  @@map("stock_transfer_items")
}

// Inventario físico / conteo cíclico.
model InventoryCount {
  id          String               @id @default(uuid(7)) @db.Uuid
  tenantId    String               @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number      Int
  warehouseId String               @db.Uuid
  cyclic      Boolean              @default(true)
  status      InventoryCountStatus @default(OPEN)
  notes       String?
  createdById String?              @db.Uuid
  closedAt    DateTime?            @db.Timestamptz(3)
  appliedAt   DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  items InventoryCountItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @default(dbgenerated("app_current_tenant()")) @db.Uuid
  countId              String   @db.Uuid
  productId            String   @db.Uuid
  lotId                String?  @db.Uuid
  systemQty            Decimal  @db.Decimal(14, 4)
  countedQty           Decimal? @db.Decimal(14, 4)
  adjustmentMovementId String?  @db.Uuid
  notes                String?

  count   InventoryCount @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Cascade)
  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot     StockLot?      @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, countId])
  @@map("inventory_count_items")
}

// -----------------------------------------------------------------------------
// COMPRAS
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number         Int
  supplierId     String              @db.Uuid
  warehouseId    String              @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  origin         PurchaseOrigin      @default(MANUAL)
  aiRunId        String?             @db.Uuid
  currency       String              @default("PEN")
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  conditions     String?
  expectedAt     DateTime?           @db.Timestamptz(3)
  sentAt         DateTime?           @db.Timestamptz(3)
  quotedAt       DateTime?           @db.Timestamptz(3)
  receivedAt     DateTime?           @db.Timestamptz(3)
  // Evita duplicar pedidos por reintentos o doble clic.
  idempotencyKey String
  createdById    String?             @db.Uuid
  approvedById   String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?           @db.Timestamptz(3)

  supplier  Supplier  @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  aiRun     AiRun?    @relation(fields: [tenantId, aiRunId], references: [tenantId, id], onDelete: Restrict)

  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  invoices PurchaseInvoice[]
  messages SupplierMessage[]
  returns  SupplierReturn[]
  aiDrafts AiOrderDraft[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

// Comprobante de compra del proveedor (factura, boleta, nota...): es lo que alimenta el Registro de Compras
// (PLE 8.1). Se captura aparte de la orden de compra porque un pedido puede tener varios comprobantes.
model PurchaseInvoice {
  id                 String         @id @default(uuid(7)) @db.Uuid
  tenantId           String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  supplierId         String?        @db.Uuid
  // Datos del proveedor congelados al registrar (el comprobante no cambia si luego se edita el proveedor).
  supplierDocType    DocumentIdType @default(RUC)
  supplierDocNumber  String?
  supplierName       String?
  // Tabla 10 de SUNAT: 01 factura, 03 boleta, 07 nota de crédito, 08 nota de débito, 02 recibo por honorarios...
  docTypeCode        String
  series             String
  number             String
  issueDate          DateTime       @db.Timestamptz(3)
  dueDate            DateTime?      @db.Timestamptz(3)
  // Periodo en que se anota (AAAAMM). Por defecto el mes de emisión; puede ser posterior (hasta 12 meses con derecho a crédito).
  period             Int
  currency           String         @default("PEN")
  taxedBase          Decimal        @default(0) @db.Decimal(14, 2)
  igv                Decimal        @default(0) @db.Decimal(14, 2)
  // Adquisiciones no gravadas.
  exemptTotal        Decimal        @default(0) @db.Decimal(14, 2)
  total              Decimal        @db.Decimal(14, 2)
  givesTaxCredit     Boolean        @default(true)
  // Cancelado con un medio de pago (bancarización) en lugar de efectivo.
  paidWithBankMethod Boolean        @default(false)
  // Solo notas de crédito/débito: comprobante que modifican.
  relatedDocTypeCode String?
  relatedSeries      String?
  relatedNumber      String?
  relatedIssueDate   DateTime?      @db.Timestamptz(3)
  purchaseOrderId    String?        @db.Uuid
  notes              String?
  createdById        String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  supplier      Supplier?      @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  // Un mismo comprobante del proveedor no se registra dos veces (respeta el borrado lógico).
  @@unique([tenantId, supplierDocNumber, docTypeCode, series, number], map: "purchase_invoices_doc_active")
  @@index([tenantId, period])
  @@map("purchase_invoices")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @default(dbgenerated("app_current_tenant()")) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  qtyOrdered  Decimal @db.Decimal(14, 4)
  qtyReceived Decimal @default(0) @db.Decimal(14, 4)
  unitCost    Decimal @db.Decimal(14, 4)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)

  order   PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  receiptItems PurchaseReceiptItem[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("app_current_tenant()")) @db.Uuid
  orderId        String   @db.Uuid
  warehouseId    String   @db.Uuid
  supplierDocRef String?
  notes          String?
  receivedById   String?  @db.Uuid
  receivedAt     DateTime @default(now()) @db.Timestamptz(3)

  order     PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  items PurchaseReceiptItem[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @default(dbgenerated("app_current_tenant()")) @db.Uuid
  receiptId        String  @db.Uuid
  orderItemId      String  @db.Uuid
  productId        String  @db.Uuid
  lotId            String? @db.Uuid
  serialId         String? @db.Uuid
  qtyExpected      Decimal @db.Decimal(14, 4)
  qtyReceived      Decimal @db.Decimal(14, 4)
  // qtyReceived - qtyExpected: diferencias registradas.
  difference       Decimal @db.Decimal(14, 4)
  unitCost         Decimal @db.Decimal(14, 4)
  kardexMovementId String? @db.Uuid
  notes            String?

  receipt   PurchaseReceipt   @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade)
  orderItem PurchaseOrderItem @relation(fields: [tenantId, orderItemId], references: [tenantId, id], onDelete: Restrict)
  product   Product           @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  lot       StockLot?         @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  serial    SerialNumber?     @relation(fields: [tenantId, serialId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, receiptId])
  @@map("purchase_receipt_items")
}

model SupplierReturn {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @db.Uuid
  number      Int
  supplierId  String   @db.Uuid
  warehouseId String   @db.Uuid
  orderId     String?  @db.Uuid
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  supplier  Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  order     PurchaseOrder? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  items SupplierReturnItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @default(dbgenerated("app_current_tenant()")) @db.Uuid
  returnId         String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 4)
  unitCost         Decimal @db.Decimal(14, 4)
  kardexMovementId String? @db.Uuid

  return  SupplierReturn @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)
  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@map("supplier_return_items")
}

// Mensajes con proveedores. Los INBOUND son datos NO CONFIABLES: jamás se
// interpretan como instrucciones (protección contra prompt injection).
model SupplierMessage {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @default(dbgenerated("app_current_tenant()")) @db.Uuid
  supplierId String           @db.Uuid
  orderId    String?          @db.Uuid
  direction  MessageDirection
  channel    MessageChannel
  body       String
  untrusted  Boolean          @default(true)
  externalId String?
  parsed     Json?
  simulated  Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  supplier Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  order    PurchaseOrder? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, supplierId, createdAt])
  @@index([tenantId, orderId])
  @@map("supplier_messages")
}

