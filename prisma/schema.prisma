// -----------------------------------------------------------------------------
// PLATAFORMA (tablas globales, sin tenantId)
// -----------------------------------------------------------------------------

model Plan {
  id                String      @id @default(uuid(7)) @db.Uuid
  code              String      @unique
  name              String
  description       String?
  priceMonthly      Decimal     @db.Decimal(14, 2)
  currency          String      @default("PEN")
  // null = ilimitado. Se aplican en BACKEND (PlanLimitError).
  maxBranches       Int?
  maxUsers          Int?
  maxWarehouses     Int?
  monthlyAiTokens   Int?
  multiWarehouse    Boolean     @default(false)
  fullWorkshop      Boolean     @default(false)
  stockAlerts       Boolean     @default(false)
  aiPurchasingAgent Boolean     @default(false)
  includedModules   AppModule[]
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?   @db.Timestamptz(3)

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  module      AppModule
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model Tenant {
  id                 String       @id @default(uuid(7)) @db.Uuid
  legalName          String
  tradeName          String?
  taxIdType          String       @default("RUC")
  taxId              String?
  country            String       @default("PE")
  currency           String       @default("PEN")
  timezone           String       @default("America/Lima")
  locale             String       @default("es-PE")
  address            String?
  city               String?
  phone              String?
  contactName        String?
  contactEmail       String?
  billingEmail       String?
  logoUrl            String?
  status             TenantStatus @default(ACTIVE)
  suspendedAt        DateTime?    @db.Timestamptz(3)
  suspendedReason    String?
  // true si la suspensión la hizo el cobro automático (solo esas se levantan solas al pagar).
  suspendedByBilling Boolean      @default(false)
  cancelledAt        DateTime?    @db.Timestamptz(3)
  // Retención configurable para tenants cancelados.
  retentionDays      Int          @default(90)
  purgeAfter         DateTime?    @db.Timestamptz(3)
  planId             String       @db.Uuid
  isDemo             Boolean      @default(false)
  demoExpiresAt      DateTime?    @db.Timestamptz(3)
  demoSessionKey     String?      @unique
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?    @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  settings              TenantSettings?
  subscriptions         Subscription[]
  branches              Branch[]
  users                 User[]
  roles                 Role[]
  customers             Customer[]
  products              Product[]
  suppliers             Supplier[]
  categories            ProductCategory[]
  warrantyPolicies      WarrantyPolicy[]
  documentSequences     DocumentSequence[]
  notifications         Notification[]
  webhookEvents         WebhookEvent[]
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]
  authTokens            AuthToken[]
  aiRuns                AiRun[]
  outboundMessages      OutboundMessage[]

  @@unique([taxIdType, taxId], map: "tenants_taxId_active")
  @@index([status])
  @@index([isDemo, demoExpiresAt])
  @@index([planId])
  @@map("tenants")
}

// Configuración por empresa. Las credenciales se guardan cifradas
// (AES-256-GCM, lib/security/crypto.ts) y jamás se exponen al cliente.
model TenantSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @default(dbgenerated("app_current_tenant()")) @db.Uuid

  // Fiscal / localización (nada hardcodeado a Perú)
  taxName                 String         @default("IGV")
  taxRate                 Decimal        @default(0.18) @db.Decimal(7, 4)
  pricesIncludeTax        Boolean        @default(true)
  enabledDocumentTypes    DocumentType[] @default([BOLETA, FACTURA, NOTA_CREDITO, NOTA_DEBITO, NOTA_VENTA])
  invoiceProvider         String?
  invoiceConfigEncrypted  String?
  ticketWidthMm           Int            @default(80)
  // Series de comprobantes (SUNAT: 4 caracteres; B/F/NV + 3 dígitos o equivalentes).
  boletaSeries            String         @default("B001")
  facturaSeries           String         @default("F001")
  creditNoteBoletaSeries  String         @default("BC01")
  creditNoteFacturaSeries String         @default("FC01")
  debitNoteBoletaSeries   String         @default("BD01")
  debitNoteFacturaSeries  String         @default("FD01")
  saleNoteSeries          String         @default("NV01")
  defaultCreditDays       Int            @default(30)
  // Diferencia de efectivo tolerada en el arqueo sin exigir una nota.
  cashTolerance           Decimal        @default(1) @db.Decimal(10, 2)
  // Supuestos del cálculo de ahorro del Agente IA y del stock muerto (editables por empresa).
  aiMinutesSavedPerLine   Int            @default(4)
  staffHourlyCost         Decimal        @default(15) @db.Decimal(10, 2)
  usdExchangeRate         Decimal        @default(3.75) @db.Decimal(8, 4)
  deadStockDays           Int            @default(90)
  enabledModules          AppModule[]

  // Inventario
  allowNegativeStock Boolean @default(false)
  tireMaxAgeYears    Int     @default(5)
  rotationWindowDays Int     @default(30)

  // IA
  openaiApiKeyEncrypted String?
  openaiApiKeyHint      String?
  aiModel               String   @default("gpt-4o-mini")
  aiTone                String?
  aiMode                AiMode   @default(DRAFT_APPROVAL)
  aiMonthlyTokenCap     Int?
  aiMonthlyCostCapUsd   Decimal? @db.Decimal(12, 4)
  aiMaxOrderAmount      Decimal? @db.Decimal(14, 2)
  aiMaxQtyPerSku        Decimal? @db.Decimal(14, 4)
  aiMaxOrdersPerDay     Int      @default(5)
  aiAutomationRules     Json?
  // Interruptores del dueño (Configuración → IA y canales).
  aiAgentEnabled         Boolean  @default(true)
  whatsappNoticesEnabled Boolean  @default(true)

  // Canales
  whatsappProvider               WhatsAppProvider?
  whatsappWebhookUrl             String?
  whatsappApiKeyEncrypted        String?
  whatsappApiKeyHint             String?
  whatsappInboundSecretEncrypted String?
  smtpHost                       String?
  smtpPort                       Int?
  smtpSecure                     Boolean           @default(true)
  smtpUser                       String?
  smtpPasswordEncrypted          String?
  smtpPasswordHint               String?
  smtpFromAddress                String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @default(dbgenerated("app_current_tenant()")) @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  gateway                PaymentGateway?
  gatewayCustomerId      String?
  gatewaySubscriptionId  String?
  // Método de pago guardado en la pasarela para cobrar renovaciones sin intervención (si la pasarela lo permite).
  gatewayPaymentMethodId String?
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  // Periodo de gracia antes de suspender por falta de pago.
  graceEndsAt            DateTime?          @db.Timestamptz(3)
  retryCount             Int                @default(0)
  nextRetryAt            DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments SubscriptionPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([status, nextRetryAt])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id               String                    @id @default(uuid(7)) @db.Uuid
  tenantId         String                    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  subscriptionId   String                    @db.Uuid
  gateway          PaymentGateway
  gatewayPaymentId String?
  amount           Decimal                   @db.Decimal(14, 2)
  currency         String
  status           SubscriptionPaymentStatus @default(PENDING)
  attempt          Int                       @default(1)
  periodStart      DateTime?                 @db.Timestamptz(3)
  periodEnd        DateTime?                 @db.Timestamptz(3)
  paidAt           DateTime?                 @db.Timestamptz(3)
  failureCode      String?
  failureMessage   String?
  // Enlace de pago vigente del periodo y referencia de pagos manuales (transferencia).
  checkoutUrl      String?
  reference        String?
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([gateway, gatewayPaymentId])
  // Un solo cobro (con sus reintentos) por suscripción y periodo.
  @@unique([subscriptionId, periodStart])
  @@index([tenantId, subscriptionId])
  @@map("subscription_payments")
}

// Eventos entrantes (pasarela, WhatsApp, proveedores) para idempotencia.
// tenantId null = evento de plataforma (solo cliente privilegiado).
model WebhookEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @db.Uuid
  source         String
  externalId     String
  signatureValid Boolean
  payload        Json
  receivedAt     DateTime  @default(now()) @db.Timestamptz(3)
  processedAt    DateTime? @db.Timestamptz(3)
  error          String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([source, externalId])
  @@index([tenantId, receivedAt])
  @@map("webhook_events")
}

// -----------------------------------------------------------------------------
// ORGANIZACIÓN, USUARIOS, RBAC
// -----------------------------------------------------------------------------

model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  code      String
  name      String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  warehouses   Warehouse[]
  users        User[]
  workOrders   WorkOrder[]
  sales        Sale[]
  cashSessions CashSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "branches_tenantId_code_active")
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  branchId  String    @db.Uuid
  code      String
  name      String
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)

  stockBalances    StockBalance[]
  stockLotBalances StockLotBalance[]
  reorderPolicies  ReorderPolicy[]
  kardex           KardexMovement[]
  serials          SerialNumber[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  inventoryCounts  InventoryCount[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  supplierReturns  SupplierReturn[]
  sales            Sale[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "warehouses_tenantId_code_active")
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model Role {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("app_current_tenant()")) @db.Uuid
  key                RoleKey?
  name               String
  description        String?
  isSystem           Boolean   @default(false)
  // Descuento máximo (% de la línea) que este rol puede aplicar en el POS.
  maxDiscountPercent Decimal   @default(0) @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, id])
  @@unique([tenantId, name], map: "roles_tenantId_name_active")
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @default(dbgenerated("app_current_tenant()")) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

// tenantId null = SuperAdmin de plataforma (solo accesible con el cliente
// privilegiado). El login busca por email vía auth_find_user_by_email().
model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  tenantId            String?    @db.Uuid
  email               String
  passwordHash        String?
  name                String
  phone               String?
  isSuperAdmin        Boolean    @default(false)
  status              UserStatus @default(INVITED)
  roleId              String?    @db.Uuid
  defaultBranchId     String?    @db.Uuid
  // Se incrementa para revocar sesiones; los permisos se leen de BD.
  sessionVersion      Int        @default(1)
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?  @db.Timestamptz(3)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?  @db.Timestamptz(3)

  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role          Role?   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  defaultBranch Branch? @relation(fields: [tenantId, defaultBranchId], references: [tenantId, id], onDelete: Restrict)

  assignedWorkOrders WorkOrder[]            @relation("WorkOrderMechanic")
  workOrderItems     WorkOrderItem[]
  sales              Sale[]
  cashSessions       CashSession[]
  notifications      Notification[]
  impersonations     ImpersonationSession[]
  authTokens         AuthToken[]

  @@unique([tenantId, id])
  @@unique([email], map: "users_email_active")
  @@index([tenantId, roleId])
  @@map("users")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String?       @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model ImpersonationSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @db.Uuid
  superAdminUserId String    @db.Uuid
  reason           String
  ip               String?
  startedAt        DateTime  @default(now()) @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  superAdmin User   @relation(fields: [superAdminUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, startedAt])
  @@map("impersonation_sessions")
}

// -----------------------------------------------------------------------------
// CLIENTES Y VEHÍCULOS
// -----------------------------------------------------------------------------

model Customer {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @default(dbgenerated("app_current_tenant()")) @db.Uuid
  docType       DocumentIdType @default(DNI)
  docNumber     String?
  name          String
  email         String?
  phone         String?
  whatsapp      String?
