model AiRun {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @default(dbgenerated("app_current_tenant()")) @db.Uuid
  kind             AiRunKind
  status           AiRunStatus @default(RUNNING)
  model            String
  prompt           Json
  response         Json?
  sentMessage      String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  costUsd          Decimal     @default(0) @db.Decimal(12, 6)
  simulated        Boolean     @default(false)
  error            String?
  idempotencyKey   String
  triggeredById    String?     @db.Uuid
  startedAt        DateTime    @default(now()) @db.Timestamptz(3)
  finishedAt       DateTime?   @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  drafts         AiOrderDraft[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startedAt])
